digraph UID {
    rankdir=TB; fontname="Liberation Serif";
    nodesep=0.8; ranksep=1.0;
    node [fontname="Liberation Serif", fontsize=10, shape=record, style=filled, fillcolor=white];
    edge [color=black, arrowsize=0.9];

    App [label="{App|+ start(primaryStage: Stage): void\l+ main(args: String[]): void\l}"];

    MainController [label="{MainController|\
- xmlPathField: TextField\l\
- urlField: TextField\l\
- loginField: TextField\l\
- outputDirField: TextField\l\
- passwordField: PasswordField\l\
- testLevelCombo: ComboBox\<String\>\l\
- siteTypeCombo: final ComboBox\<String\>\l\
- subsystemField: final TextField\l\
- smokeAllSubsystemsCheck: CheckBox\l\
- fastModeCheck: CheckBox\l\
- btnSelectXml: Button\l\
- btnSelectOutputDir: Button\l\
- btnParse: Button\l\
- btnGenerate: Button\l\
- btnRunTests: Button\l\
- btnRunSelected: Button\l\
- btnShowHistory: Button\l\
- TEST_CATEGORIES: static final String[][]\l\
- entityListView: ListView\<String\>\l\
- resultsTable: TableView\<TestCaseRow\>\l\
- colClass: TableColumn\<TestCaseRow, String\>\l\
- colMethod: TableColumn\<TestCaseRow, String\>\l\
- colStatus: TableColumn\<TestCaseRow, String\>\l\
- colDuration: TableColumn\<TestCaseRow, String\>\l\
- colMessage: TableColumn\<TestCaseRow, String\>\l\
- statusLabel: Label\l\
- progressBar: ProgressBar\l\
- logArea: TextArea\l\
- totalLabel: Label\l\
- passedLabel: Label\l\
- failedLabel: Label\l\
- currentModel: AppModel\l\
- reportDao: final ReportDao\l\
|\
+ initialize(): void\l\
- onSelectXml(): void\l\
- onSelectOutputDir(): void\l\
- onParse(): void\l\
- onGenerate(): void\l\
- onRunTests(): void\l\
- onRunSelected(): void\l\
+ buildTestFilter(entityChecks, typeChecks): static String\l\
- launchRun(testFilter: String): void\l\
- onShowHistory(): void\l\
- displayResults(result: TestRunResult): void\l\
- getXmlFileName(): String\l\
- log(message: String): void\l\
- showAlert(title: String, content: String): void\l\
}"];

    TestCaseRow [label="{TestCaseRow|\
- className: final String\l\
- methodName: final String\l\
- status: final String\l\
- duration: final String\l\
- message: final String\l\
|\
+ TestCaseRow(className, methodName, status, duration, message)\l\
+ getClassName(): String\l\
+ getMethodName(): String\l\
+ getStatus(): String\l\
+ getDuration(): String\l\
+ getMessage(): String\l\
}"];

    App -> MainController [taillabel="1", headlabel="1"];
    MainController -> TestCaseRow [arrowtail=diamond, dir=back, taillabel="1", headlabel="*"];
}
