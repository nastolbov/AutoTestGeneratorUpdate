digraph UID {
    rankdir=TB; fontname="Liberation Serif";
    nodesep=0.8; ranksep=1.0;
    node [fontname="Liberation Serif", fontsize=10, shape=record, style=filled, fillcolor=white];
    edge [color=black, fontname="Liberation Serif", fontsize=10, labeldistance=2.0, arrowsize=0.9];

    App [label="{App|+ start(primaryStage: Stage): void\l+ main(args: String[]): void\l}"];

    MainController [label="{MainController|\
- xmlPathField, urlField, loginField, outputDirField: TextField\l\
- passwordField: PasswordField\l\
- testLevelCombo, siteTypeCombo: ComboBox\<String\>\l\
- smokeAllSubsystemsCheck, fastModeCheck: CheckBox\l\
- btnSelectXml, btnParse, btnGenerate, btnRunTests,\l\
\ \ btnRunSelected, btnShowHistory: Button\l\
- entityListView: ListView\<String\>\l\
- resultsTable: TableView\<TestCaseRow\>\l\
- currentModel: AppModel\l\
- reportDao: final ReportDao\l\
|\
+ initialize(): void\l\
- onParse(): void\l\
- onGenerate(): void\l\
- onRunTests(): void\l\
- onRunSelected(): void\l\
- launchRun(filter: String): void\l\
- onShowHistory(): void\l\
- displayResults(r: TestRunResult): void\l\
- log(msg: String): void\l\
}"];

    TestCaseRow [label="{TestCaseRow|\
- className: final String\l\
- methodName: final String\l\
- status: final String\l\
- duration: final String\l\
- message: final String\l\
|\
+ TestCaseRow(...)\l\
+ getClassName(): String\l\
+ getMethodName(): String\l\
+ getStatus(): String\l\
+ getDuration(): String\l\
+ getMessage(): String\l\
}"];

    App -> MainController [taillabel="1", headlabel="1"];
    MainController -> TestCaseRow [arrowtail=diamond, dir=back, taillabel="1", headlabel="*"];
}
