digraph CoopUI {
    rankdir=TB; fontname="Liberation Serif";
    nodesep=1.0; ranksep=1.0;
    node [fontname="Liberation Serif", fontsize=11, shape=box, style=filled, fillcolor=white];
    edge [color=black, fontname="Liberation Serif", fontsize=9, arrowsize=0.9];

    User [shape=none, label=<<TABLE BORDER="0"><TR><TD><FONT POINT-SIZE="36">&#9786;</FONT></TD></TR><TR><TD>Пользователь</TD></TR></TABLE>>];
    App  [label="App"];
    MC   [label=":MainController"];
    Task [label=":Task"];
    Row  [label=":TestCaseRow"];

    User -> App  [label="команды:\nзапуск, закрытие окна"];
    App  -> MC   [label="загрузка FXML,\nсоздание контроллера"];
    MC   -> MC   [label="обработка кликов:\nразобрать, сгенерировать,\nзапустить тесты"];
    MC   -> Task [label="фоновая задача:\nTestRunner.run + фильтр"];
    Task -> MC   [label="результат прогона\n(TestRunResult)"];
    MC   -> Row  [label="строки таблицы:\nкласс, метод, статус,\nвремя, сообщение"];
    MC   -> User [label="отображение таблицы,\nлог в журнал, Alert ошибок"];
}
