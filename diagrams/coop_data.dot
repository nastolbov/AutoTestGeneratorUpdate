digraph CoopData {
    rankdir=TB; fontname="Liberation Serif";
    nodesep=0.9; ranksep=0.9;
    node [fontname="Liberation Serif", fontsize=11, shape=box, style=filled, fillcolor=white];
    edge [color=black, fontname="Liberation Serif", fontsize=9, arrowsize=0.9];

    MC   [label=":MainController"];
    RD   [label=":ReportDao"];
    DC   [label=":DatabaseConnection"];
    TRD  [label=":TestRunDao"];
    TCD  [label=":TestCaseDao"];
    SI   [label=":SchemaInitializer"];
    DB   [shape=cylinder, label="autotestgen.db"];

    MC  -> RD  [label="запрос: сохранить результат\nили загрузить историю"];
    RD  -> SI  [label="при создании:\nинициализировать схему БД"];
    SI  -> DC  [label="запрос соединения\n→ Connection"];
    RD  -> DC  [label="запрос соединения\nдля транзакции"];
    DC  -> DB  [label="JDBC: CREATE TABLE,\nоткрытие сессии"];
    RD  -> TRD [label="Connection + результат\nпрогона (TestRunResult)"];
    RD  -> TCD [label="Connection + runId\n+ список TestCaseResult"];
    TRD -> DB  [label="INSERT в test_run,\nвозврат сгенерированного id"];
    TCD -> DB  [label="batch INSERT в test_case\n(все кейсы прогона)"];
    RD  -> MC  [label="результат: void (запись)\nили список TestRunResult"];
}
