digraph ClsCommonRefined {
    rankdir=LR;
    fontname="DejaVu Sans";
    label="Рис. 52. Уточнённая диаграмма классов пакета «Common»";
    labelloc="b";
    fontsize=14;
    nodesep=0.8;

    node [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled"];

    Transliterator  [fillcolor="#F0F0F0", peripheries=2, label=<<I>«utility»</I><BR/><B>Transliterator</B>>];
    JavaFileWriter  [fillcolor="#F0F0F0", peripheries=2, label=<<I>«utility»</I><BR/><B>JavaFileWriter</B>>];
    ParserException [fillcolor="#FFCDD2", label=<<I>«exception»</I><BR/><B>ParserException</B>>];

    // Классы пакета между собой не связаны — это листовой пакет утилит.
    // Связей нет (используются извне другими пакетами).
}
