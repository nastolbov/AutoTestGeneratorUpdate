digraph Gen {
    rankdir=TB; fontname="DejaVu Sans"; fontsize=14;
    label="Рис. 32. Уточнённая диаграмма классов пакета «Generator»"; labelloc=b;
    nodesep=0.5; ranksep=0.9;
    node [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled", fillcolor=white];
    edge [color=black, fontname="DejaVu Sans", fontsize=10];

    TestConfig       [label="TestConfig"];
    TestGenerator    [label="TestGenerator\n«дирижёр»"];
    PageObjectWriter [label="PageObjectWriter"];
    TestClassWriter  [label="TestClassWriter"];
    TestDataFactory  [peripheries=2, label="TestDataFactory\n«utility»"];
    TestRunner       [label="TestRunner"];
    RunReportWriter  [label="RunReportWriter"];

    TestGenerator -> TestConfig [arrowtail=odiamond, dir=back, label="1"];
    TestGenerator -> PageObjectWriter [style=dashed, label="«create»\nцикл по сущностям", fontsize=9];
    TestGenerator -> TestClassWriter  [style=dashed, label="«create»\nцикл по сущностям", fontsize=9];
    TestGenerator -> TestDataFactory  [style=dashed, label="«use»"];
    PageObjectWriter -> TestDataFactory [style=dashed];
    TestClassWriter  -> TestDataFactory [style=dashed];

    { rank=same; TestConfig; TestGenerator; }
    { rank=same; PageObjectWriter; TestClassWriter; TestRunner; RunReportWriter; }
    { rank=same; TestDataFactory; }
