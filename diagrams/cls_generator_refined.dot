digraph cls_generator_refined {
    rankdir=TB; fontname="Liberation Serif";
    nodesep=0.8; ranksep=1.1;
    node [fontname="Liberation Serif", fontsize=12, shape=box, style=filled, fillcolor=white];
    edge [color=black, fontname="Liberation Serif", fontsize=10, labeldistance=2.0, arrowsize=0.9];

    TC  [label="TestConfig"];
    TG  [label="TestGenerator"];
    POW [label="PageObjectWriter"];
    TCW [label="TestClassWriter"];
    TDF [label="TestDataFactory"];
    TR  [label="TestRunner"];
    RRW [label="RunReportWriter"];
    TG -> TC [arrowtail=odiamond, dir=back, label="содержит"];
    TG -> POW [label="использует"];
    TG -> TCW [label="использует"];
    POW -> TDF [label="использует"]; TCW -> TDF [label="использует"];
    TR -> RRW [label="использует"];
    { rank=same; TC; TG; }
    { rank=same; POW; TCW; TR; }
    { rank=same; TDF; RRW; }

}
