digraph GR {
    rankdir=TB; fontname="DejaVu Sans"; fontsize=14;
    label="Рис. 32. Уточнённая диаграмма классов пакета «Generator»"; labelloc=b;
    nodesep=0.5; ranksep=0.9;
    node [fontname="DejaVu Sans", fontsize=11, shape=box, style=filled, fillcolor=white];
    edge [color=black, fontname="DejaVu Sans", fontsize=10];

    TC  [label="TestConfig"];
    TG  [label="TestGenerator"];
    POW [label="PageObjectWriter"];
    TCW [label="TestClassWriter"];
    TDF [label="TestDataFactory"];
    TR  [label="TestRunner"];
    RRW [label="RunReportWriter"];

    TG -> TC  [arrowtail=odiamond, dir=back, taillabel="1", headlabel="1"];
    TG -> POW [taillabel="1", headlabel="*"];
    TG -> TCW [taillabel="1", headlabel="*"];
    TG -> TDF [taillabel="1", headlabel="1"];
    POW -> TDF [taillabel="1", headlabel="1"];
    TCW -> TDF [taillabel="1", headlabel="1"];

    { rank=same; TC; TG; }
    { rank=same; POW; TCW; TR; RRW; }
    { rank=same; TDF; }
}
