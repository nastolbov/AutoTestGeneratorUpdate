digraph MD {
    rankdir=TB; fontname="Liberation Serif"; fontsize=14;
    label="Рис. 31. Детальная диаграмма классов пакета «Model»"; labelloc=b;
    nodesep=0.4; ranksep=0.6;
    node [fontname="Liberation Serif", fontsize=9, shape=plaintext];
    edge [color=black, fontname="Liberation Serif", fontsize=9, labeldistance=2.0, arrowsize=0.9];

    AM [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD ALIGN="CENTER"><B>AppModel</B></TD></TR>
        <TR><TD ALIGN="LEFT">- categoryName, guid: String<BR ALIGN="LEFT"/>
            - entities: List&lt;EntityObject&gt;<BR ALIGN="LEFT"/>
            - searches: List&lt;Search&gt;<BR ALIGN="LEFT"/></TD></TR>
        <TR><TD ALIGN="LEFT">+ findEntityByGuid(guid: String):<BR ALIGN="LEFT"/>
            &nbsp;&nbsp;EntityObject<BR ALIGN="LEFT"/>
            + getSubsystemNameFromCategory(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

    EO [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD ALIGN="CENTER"><B>EntityObject</B></TD></TR>
        <TR><TD ALIGN="LEFT">- guid, name, keyName,<BR ALIGN="LEFT"/>
            &nbsp;&nbsp;featureName, nameValueMethod: String<BR ALIGN="LEFT"/>
            - associations: List&lt;Association&gt;<BR ALIGN="LEFT"/>
            - propertyGroups: List&lt;PropertyGroup&gt;<BR ALIGN="LEFT"/></TD></TR>
        <TR><TD ALIGN="LEFT">+ hasCrudOperations(): boolean<BR ALIGN="LEFT"/>
            + getFormView(): PropertyGroup<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

    PG [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD ALIGN="CENTER"><B>PropertyGroup</B></TD></TR>
        <TR><TD ALIGN="LEFT">- guid, name, stereoType,<BR ALIGN="LEFT"/>
            &nbsp;&nbsp;dmodule, typeLink: String<BR ALIGN="LEFT"/>
            - orderNumber: int<BR ALIGN="LEFT"/>
            - flagDisplay: boolean<BR ALIGN="LEFT"/>
            - properties: List&lt;Property&gt;<BR ALIGN="LEFT"/>
            - operation: Operation<BR ALIGN="LEFT"/></TD></TR>
        <TR><TD ALIGN="LEFT">+ isFormView(): boolean<BR ALIGN="LEFT"/>
            + isGridView(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

    P [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD ALIGN="CENTER"><B>Property</B></TD></TR>
        <TR><TD ALIGN="LEFT">- guid, name, stereoType,<BR ALIGN="LEFT"/>
            &nbsp;&nbsp;attrName, tableName, mask,<BR ALIGN="LEFT"/>
            &nbsp;&nbsp;defValueSource, comment: String<BR ALIGN="LEFT"/>
            - attrType: AttrType<BR ALIGN="LEFT"/>
            - required, flagDisplay: boolean<BR ALIGN="LEFT"/>
            - orderNumber: int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

    Op [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD ALIGN="CENTER"><B>Operation</B></TD></TR>
        <TR><TD ALIGN="LEFT">- guid, operationMethod,<BR ALIGN="LEFT"/>
            &nbsp;&nbsp;operationModule: String<BR ALIGN="LEFT"/>
            - params: List&lt;OperationParam&gt;<BR ALIGN="LEFT"/>
            - modifiers: List&lt;Modifier&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

    A [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD ALIGN="CENTER"><B>Association</B></TD></TR>
        <TR><TD ALIGN="LEFT">- guid, roleA, roleB, featureName,<BR ALIGN="LEFT"/>
            &nbsp;&nbsp;associationId, associateItemName,<BR ALIGN="LEFT"/>
            &nbsp;&nbsp;associateItemGuid, searchGuid: String<BR ALIGN="LEFT"/>
            - flagDisplay, addFromTree: boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

    S [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD ALIGN="CENTER"><B>Search</B></TD></TR>
        <TR><TD ALIGN="LEFT">- guid, name, query: String<BR ALIGN="LEFT"/>
            - minParamCount: int<BR ALIGN="LEFT"/>
            - params: List&lt;SearchParam&gt;<BR ALIGN="LEFT"/>
            - result: SearchResult<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

    EC [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD ALIGN="CENTER"><B>EntityClassifier</B></TD></TR>
        <TR><TD ALIGN="LEFT">+ classify(entity: EntityObject,<BR ALIGN="LEFT"/>
            &nbsp;&nbsp;model: AppModel):<BR ALIGN="LEFT"/>
            &nbsp;&nbsp;static Classification<BR ALIGN="LEFT"/>
            - findParentGrid, isFkTargetOnly,<BR ALIGN="LEFT"/>
            &nbsp;&nbsp;isReferenceDictionary,<BR ALIGN="LEFT"/>
            &nbsp;&nbsp;nameStemsMatch<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

    CL [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD ALIGN="CENTER"><B>Classification</B></TD></TR>
        <TR><TD ALIGN="LEFT">+ kind: final EntityKind<BR ALIGN="LEFT"/>
            + reason: final String<BR ALIGN="LEFT"/>
            + parentEntity: final EntityObject<BR ALIGN="LEFT"/>
            + parentGrid: final PropertyGroup<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

    TRR [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD ALIGN="CENTER"><B>TestRunResult</B></TD></TR>
        <TR><TD ALIGN="LEFT">- totalTests, passed, failed, skipped: int<BR ALIGN="LEFT"/>
            - durationMs: long<BR ALIGN="LEFT"/>
            - runTimestamp: LocalDateTime<BR ALIGN="LEFT"/>
            - xmlFileName, baseUrl: String<BR ALIGN="LEFT"/>
            - results: List&lt;TestCaseResult&gt;<BR ALIGN="LEFT"/>
            - mavenOutput: String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

    TCR [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD ALIGN="CENTER"><B>TestCaseResult</B></TD></TR>
        <TR><TD ALIGN="LEFT">- className, methodName,<BR ALIGN="LEFT"/>
            &nbsp;&nbsp;failureMessage, stdOut: String<BR ALIGN="LEFT"/>
            - passed, skipped: boolean<BR ALIGN="LEFT"/>
            - durationMs: long<BR ALIGN="LEFT"/>
            - screenshots: List&lt;String&gt;<BR ALIGN="LEFT"/>
            - steps: List&lt;StepTiming&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

    AM -> EO [arrowtail=diamond, dir=back, taillabel="1", headlabel="1..*"];
    AM -> S  [arrowtail=diamond, dir=back, taillabel="1", headlabel="0..*"];
    EO -> PG [arrowtail=diamond, dir=back, taillabel="1", headlabel="1..*"];
    EO -> A  [arrowtail=diamond, dir=back, taillabel="1", headlabel="0..*"];
    PG -> P  [arrowtail=diamond, dir=back, taillabel="1", headlabel="1..*"];
    PG -> Op [arrowtail=diamond, dir=back, taillabel="1", headlabel="0..1"];
    EC -> CL [taillabel="1", headlabel="*"];
    TRR -> TCR [arrowtail=diamond, dir=back, taillabel="1", headlabel="0..*"];
    CL -> EO [arrowtail=odiamond, dir=back, taillabel="0..1", headlabel="0..1"];
    CL -> PG [arrowtail=odiamond, dir=back, taillabel="0..1", headlabel="0..1"];
}
