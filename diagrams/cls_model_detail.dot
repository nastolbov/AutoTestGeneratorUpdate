digraph MD {
    rankdir=TB; fontname="Liberation Serif";
    nodesep=0.4; ranksep=0.6;
    node [fontname="Liberation Serif", fontsize=9, shape=record, style=filled, fillcolor=white];
    edge [color=black, fontname="Liberation Serif", fontsize=9, labeldistance=2.0, arrowsize=0.9];

    AM [label="{AppModel|\
- categoryName, guid: String\l\
- entities: List\<EntityObject\>\l\
- searches: List\<Search\>\l\
|\
+ findEntityByGuid(guid: String): EntityObject\l\
+ getSubsystemNameFromCategory(): String\l\
}"];

    EO [label="{EntityObject|\
- guid, name, keyName, featureName,\l\
\ \ nameValueMethod: String\l\
- associations: List\<Association\>\l\
- propertyGroups: List\<PropertyGroup\>\l\
|\
+ hasCrudOperations(): boolean\l\
+ getFormView(): PropertyGroup\l\
}"];

    PG [label="{PropertyGroup|\
- guid, name, stereoType, dmodule, typeLink: String\l\
- orderNumber: int\l\
- flagDisplay: boolean\l\
- properties: List\<Property\>\l\
- operation: Operation\l\
|\
+ isFormView(): boolean\l\
+ isGridView(): boolean\l\
}"];

    P [label="{Property|\
- guid, name, stereoType, attrName, tableName,\l\
\ \ mask, defValueSource, comment: String\l\
- attrType: AttrType\l\
- required, flagDisplay: boolean\l\
- orderNumber: int\l\
|\
}"];

    Op [label="{Operation|\
- guid, operationMethod, operationModule: String\l\
- params: List\<OperationParam\>\l\
- modifiers: List\<Modifier\>\l\
|\
}"];

    A [label="{Association|\
- guid, roleA, roleB, featureName,\l\
\ \ associationId, associateItemName,\l\
\ \ associateItemGuid, searchGuid: String\l\
- flagDisplay, addFromTree: boolean\l\
|\
}"];

    S [label="{Search|\
- guid, name, query: String\l\
- minParamCount: int\l\
- params: List\<SearchParam\>\l\
- result: SearchResult\l\
|\
}"];

    EC [label="{EntityClassifier|\
|\
+ classify(entity, model): static Classification\l\
- findParentGrid, isFkTargetOnly,\l\
\ \ isReferenceDictionary, nameStemsMatch\l\
}"];

    CL [label="{Classification|\
+ kind: final EntityKind\l\
+ reason: final String\l\
+ parentEntity: final EntityObject\l\
+ parentGrid: final PropertyGroup\l\
|\
}"];

    TRR [label="{TestRunResult|\
- totalTests, passed, failed, skipped: int\l\
- durationMs: long\l\
- runTimestamp: LocalDateTime\l\
- xmlFileName, baseUrl: String\l\
- results: List\<TestCaseResult\>\l\
- mavenOutput: String\l\
|\
}"];

    TCR [label="{TestCaseResult|\
- className, methodName, failureMessage, stdOut: String\l\
- passed, skipped: boolean\l\
- durationMs: long\l\
- screenshots: List\<String\>\l\
- steps: List\<StepTiming\>\l\
|\
}"];

    AM -> EO [arrowtail=diamond, dir=back, taillabel="1", headlabel="1..*"];
    AM -> S  [arrowtail=diamond, dir=back, taillabel="1", headlabel="0..*"];
    EO -> PG [arrowtail=diamond, dir=back, taillabel="1", headlabel="1..*"];
    EO -> A  [arrowtail=diamond, dir=back, taillabel="1", headlabel="0..*"];
    PG -> P  [arrowtail=diamond, dir=back, taillabel="1", headlabel="1..*"];
    PG -> Op [arrowtail=diamond, dir=back, taillabel="1", headlabel="0..1"];
    EC -> CL [taillabel="1", headlabel="*"];
    TRR -> TCR [arrowtail=diamond, dir=back, taillabel="1", headlabel="0..*"];
    CL -> EO [arrowtail=odiamond, dir=back, taillabel="0..1", headlabel="0..1"];
    CL -> PG [arrowtail=odiamond, dir=back, taillabel="0..1", headlabel="0..1"];
}
