digraph MD {
    rankdir=TB; fontname="DejaVu Sans"; fontsize=14;
    label="Рис. 31. Детальная диаграмма классов пакета «Model»"; labelloc=b;
    nodesep=0.3; ranksep=0.5;
    node [fontname="DejaVu Sans", fontsize=9, shape=plaintext];

    AM [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
        <TR><TD><B>AppModel</B></TD></TR>
        <TR><TD ALIGN="LEFT">— categoryName, guid: String<BR/>
            — entities: List&lt;EntityObject&gt;<BR/>
            — searches: List&lt;Search&gt;</TD></TR>
        <TR><TD ALIGN="LEFT">+ findEntityByGuid(guid: String):<BR/>
              EntityObject<BR/>
            + getSubsystemNameFromCategory(): String</TD></TR></TABLE>>];

    EO [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
        <TR><TD><B>EntityObject</B></TD></TR>
        <TR><TD ALIGN="LEFT">— guid, name, keyName,<BR/>
              featureName, nameValueMethod: String<BR/>
            — associations: List&lt;Association&gt;<BR/>
            — propertyGroups: List&lt;PropertyGroup&gt;</TD></TR>
        <TR><TD ALIGN="LEFT">+ hasCrudOperations(): boolean<BR/>
            + getFormView(): PropertyGroup</TD></TR></TABLE>>];

    PG [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
        <TR><TD><B>PropertyGroup</B></TD></TR>
        <TR><TD ALIGN="LEFT">— guid, name, stereoType,<BR/>
              dmodule, typeLink: String<BR/>
            — orderNumber: int<BR/>
            — flagDisplay: boolean<BR/>
            — properties: List&lt;Property&gt;<BR/>
            — operation: Operation</TD></TR>
        <TR><TD ALIGN="LEFT">+ isFormView(): boolean<BR/>
            + isGridView(): boolean</TD></TR></TABLE>>];

    P [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
        <TR><TD><B>Property</B></TD></TR>
        <TR><TD ALIGN="LEFT">— guid, name, stereoType,<BR/>
              attrName, tableName, mask,<BR/>
              defValueSource, comment: String<BR/>
            — attrType: AttrType<BR/>
            — required, flagDisplay: boolean<BR/>
            — orderNumber: int</TD></TR></TABLE>>];

    Op [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
        <TR><TD><B>Operation</B></TD></TR>
        <TR><TD ALIGN="LEFT">— guid, operationMethod,<BR/>
              operationModule: String<BR/>
            — params: List&lt;OperationParam&gt;<BR/>
            — modifiers: List&lt;Modifier&gt;</TD></TR></TABLE>>];

    A [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
        <TR><TD><B>Association</B></TD></TR>
        <TR><TD ALIGN="LEFT">— guid, roleA, roleB, featureName,<BR/>
              associationId, associateItemName,<BR/>
              associateItemGuid, searchGuid: String<BR/>
            — flagDisplay, addFromTree: boolean</TD></TR></TABLE>>];

    S [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
        <TR><TD><B>Search</B></TD></TR>
        <TR><TD ALIGN="LEFT">— guid, name, query: String<BR/>
            — minParamCount: int<BR/>
            — params: List&lt;SearchParam&gt;<BR/>
            — result: SearchResult</TD></TR></TABLE>>];

    EC [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
        <TR><TD><B>EntityClassifier</B></TD></TR>
        <TR><TD ALIGN="LEFT">+ classify(entity: EntityObject,<BR/>
              model: AppModel):<BR/>
              static Classification<BR/>
            — findParentGrid, isFkTargetOnly,<BR/>
              isReferenceDictionary,<BR/>
              nameStemsMatch</TD></TR></TABLE>>];

    CL [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
        <TR><TD><B>Classification</B></TD></TR>
        <TR><TD ALIGN="LEFT">+ kind: final EntityKind<BR/>
            + reason: final String<BR/>
            + parentEntity: final EntityObject<BR/>
            + parentGrid: final PropertyGroup</TD></TR></TABLE>>];

    TRR [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
        <TR><TD><B>TestRunResult</B></TD></TR>
        <TR><TD ALIGN="LEFT">— totalTests, passed, failed, skipped: int<BR/>
            — durationMs: long<BR/>
            — runTimestamp: LocalDateTime<BR/>
            — xmlFileName, baseUrl: String<BR/>
            — results: List&lt;TestCaseResult&gt;<BR/>
            — mavenOutput: String</TD></TR></TABLE>>];

    TCR [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
        <TR><TD><B>TestCaseResult</B></TD></TR>
        <TR><TD ALIGN="LEFT">— className, methodName,<BR/>
              failureMessage, stdOut: String<BR/>
            — passed, skipped: boolean<BR/>
            — durationMs: long<BR/>
            — screenshots: List&lt;String&gt;<BR/>
            — steps: List&lt;StepTiming&gt;</TD></TR></TABLE>>];

    AM -> EO [arrowtail=diamond, dir=back, taillabel="1", headlabel="1..*"];
    AM -> S  [arrowtail=diamond, dir=back, taillabel="1", headlabel="0..*"];
    EO -> PG [arrowtail=diamond, dir=back, taillabel="1", headlabel="1..*"];
    EO -> A  [arrowtail=diamond, dir=back, taillabel="1", headlabel="0..*"];
    PG -> P  [arrowtail=diamond, dir=back, taillabel="1", headlabel="1..*"];
    PG -> Op [arrowtail=diamond, dir=back, taillabel="1", headlabel="0..1"];
    EC -> CL [taillabel="1", headlabel="*"];
    TRR -> TCR [arrowtail=diamond, dir=back, taillabel="1", headlabel="0..*"];
    CL -> EO [arrowtail=odiamond, dir=back, taillabel="0..1", headlabel="0..1"];
    CL -> PG [arrowtail=odiamond, dir=back, taillabel="0..1", headlabel="0..1"];
}
