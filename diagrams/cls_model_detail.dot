digraph MD {
    rankdir=TB; fontname="Liberation Serif";
    nodesep=0.4; ranksep=0.7;
    node [fontname="Liberation Serif", fontsize=9, shape=record, style=filled, fillcolor=white];
    edge [color=black, arrowsize=0.9];

    AM [label="{AppModel|\
- categoryName: String\l\
- guid: String\l\
- entities: List\<EntityObject\>\l\
- searches: List\<Search\>\l\
|\
+ findEntityByGuid(guid: String): EntityObject\l\
+ getSubsystemNameFromCategory(): String\l\
}"];

    EO [label="{EntityObject|\
- guid: String\l\
- name: String\l\
- keyName: String\l\
- featureName: String\l\
- nameValueMethod: String\l\
- associations: List\<Association\>\l\
- propertyGroups: List\<PropertyGroup\>\l\
|\
+ hasCrudOperations(): boolean\l\
+ getFormView(): PropertyGroup\l\
}"];

    PG [label="{PropertyGroup|\
- guid: String\l\
- name: String\l\
- stereoType: String\l\
- dmodule: String\l\
- typeLink: String\l\
- orderNumber: int\l\
- flagDisplay: boolean\l\
- properties: List\<Property\>\l\
- operation: Operation\l\
|\
+ isFormView(): boolean\l\
+ isGridView(): boolean\l\
}"];

    P [label="{Property|\
- guid: String\l\
- name: String\l\
- stereoType: String\l\
- attrName: String\l\
- tableName: String\l\
- mask: String\l\
- defValueSource: String\l\
- comment: String\l\
- attrType: AttrType\l\
- required: boolean\l\
- flagDisplay: boolean\l\
- orderNumber: int\l\
|\
}"];

    Op [label="{Operation|\
- guid: String\l\
- operationMethod: String\l\
- operationModule: String\l\
- params: List\<OperationParam\>\l\
- modifiers: List\<Modifier\>\l\
|\
}"];

    A [label="{Association|\
- guid: String\l\
- roleA: String\l\
- roleB: String\l\
- featureName: String\l\
- associationId: String\l\
- associateItemName: String\l\
- associateItemGuid: String\l\
- searchGuid: String\l\
- flagDisplay: boolean\l\
- addFromTree: boolean\l\
|\
}"];

    S [label="{Search|\
- guid: String\l\
- name: String\l\
- query: String\l\
- minParamCount: int\l\
- params: List\<SearchParam\>\l\
- result: SearchResult\l\
|\
}"];

    EC [label="{EntityClassifier|\
|\
+ classify(entity, model): static Classification\l\
- findParentGrid(entity, model): Classification\l\
- isFkTargetOnly(entity, model): String\l\
- isReferenceDictionary(entity, model): String\l\
- nameStemsMatch(a, b): boolean\l\
}"];

    CL [label="{Classification|\
+ kind: final EntityKind\l\
+ reason: final String\l\
+ parentEntity: final EntityObject\l\
+ parentGrid: final PropertyGroup\l\
|\
}"];

    TRR [label="{TestRunResult|\
- totalTests: int\l\
- passed: int\l\
- failed: int\l\
- skipped: int\l\
- durationMs: long\l\
- runTimestamp: LocalDateTime\l\
- xmlFileName: String\l\
- baseUrl: String\l\
- results: List\<TestCaseResult\>\l\
- mavenOutput: String\l\
|\
}"];

    TCR [label="{TestCaseResult|\
- className: String\l\
- methodName: String\l\
- failureMessage: String\l\
- stdOut: String\l\
- passed: boolean\l\
- skipped: boolean\l\
- durationMs: long\l\
- screenshots: List\<String\>\l\
- steps: List\<StepTiming\>\l\
|\
}"];

    AM -> EO [arrowtail=diamond, dir=back];
    AM -> S  [arrowtail=diamond, dir=back];
    EO -> PG [arrowtail=diamond, dir=back];
    EO -> A  [arrowtail=diamond, dir=back];
    PG -> P  [arrowtail=diamond, dir=back];
    PG -> Op [arrowtail=diamond, dir=back];
    EC -> CL;
    TRR -> TCR [arrowtail=diamond, dir=back];
    CL -> EO [arrowtail=odiamond, dir=back];
    CL -> PG [arrowtail=odiamond, dir=back];
}
