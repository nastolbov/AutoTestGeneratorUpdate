digraph Constantine {
    rankdir=TB;
    ranksep=1.0;
    nodesep=0.45;
    fontname="DejaVu Sans";
    label="Структурная карта Константайна\nдля информационной системы AutoTestGenerator";
    labelloc="t";
    fontsize=18;

    node [fontname="DejaVu Sans", fontsize=11];
    edge [fontname="DejaVu Sans", fontsize=9];

    // ==== МОДУЛИ (rect, одинарная рамка) ====
    App                 [shape=box, label="App\n(точка входа)"];
    MainController      [shape=box, label="MainController"];
    XmlModelParser      [shape=box, label="XmlModelParser"];
    EntityParser        [shape=box, label="EntityParser"];
    SearchParser        [shape=box, label="SearchParser"];
    PropertyGroupParser [shape=box, label="PropertyGroupParser"];
    TestConfig          [shape=box, label="TestConfig"];
    TestGenerator       [shape=box, label="TestGenerator"];
    PageObjectWriter    [shape=box, label="PageObjectWriter"];
    TestClassWriter     [shape=box, label="TestClassWriter"];
    EntityClassifier    [shape=box, label="EntityClassifier"];
    TestDataFactory     [shape=box, label="TestDataFactory"];
    TestRunner          [shape=box, label="TestRunner"];
    ReportDao           [shape=box, label="ReportDao"];

    // ==== БИБЛИОТЕКИ (rect с двойной рамкой = peripheries=2) ====
    StaxUtils      [shape=box, peripheries=2, label="StaxUtils"];
    XmlNamespaces  [shape=box, peripheries=2, label="XmlNamespaces"];
    JavaFileWriter [shape=box, peripheries=2, label="JavaFileWriter"];
    Transliterator [shape=box, peripheries=2, label="Transliterator"];

    // ==== ОБЛАСТИ ДАННЫХ (овал) ====
    SQLite   [shape=ellipse, label="autotestgen.db\n(SQLite)"];
    GenFiles [shape=ellipse, label="generated-tests/\n*.java, pom.xml,\nsurefire-reports/"];

    // ==== СВЯЗИ ====
    // Уровень 1 → 2: однократный вызов (метка «1»)
    App -> MainController [label="  1\n(FXML)"];

    // Уровень 2 → 3: вызовы с couples по данным и управлению
    MainController -> XmlModelParser
        [label="↓○ File\n↑○ AppModel"];
    MainController -> TestConfig
        [label="↓○ setters"];
    MainController -> TestGenerator
        [label="↓○ AppModel,\n   TestConfig"];
    MainController -> TestRunner
        [label="↓○ outputDir, filter\n↓● fastMode"];
    MainController -> ReportDao
        [label="↓○ TestRunResult\n↑○ List<TestRunResult>"];

    // Уровень 3 → 4: парсеры (вложенно)
    XmlModelParser -> EntityParser
        [label="↓○ reader\n↑○ EntityObject"];
    XmlModelParser -> SearchParser
        [label="↓○ reader\n↑○ List<Search>"];
    EntityParser -> PropertyGroupParser
        [label="↓○ reader\n↑○ PropertyGroup"];

    // Уровень 3 → 4: писатели и классификатор (циклический вызов по сущностям)
    TestGenerator -> EntityClassifier
        [label="цикл\n↓○ entity, model\n↑○ Classification"];
    TestGenerator -> PageObjectWriter
        [label="цикл\n↓○ entity, config"];
    TestGenerator -> TestClassWriter
        [label="цикл\n↓○ entity, model,\n   config"];
    TestGenerator -> TestDataFactory
        [label="↓○ property\n↑○ String"];

    // Уровень 4 → 5: библиотеки (common coupling — пунктир)
    EntityParser        -> StaxUtils
        [label="↓○ reader, name\n↑○ value", style=dashed];
    SearchParser        -> StaxUtils [style=dashed];
    PropertyGroupParser -> StaxUtils [style=dashed];
    EntityParser        -> XmlNamespaces
        [label="↑○ NS_E, NS_E3", style=dashed];
    SearchParser        -> XmlNamespaces [style=dashed];
    PropertyGroupParser -> XmlNamespaces [style=dashed];

    PageObjectWriter -> JavaFileWriter
        [label="↓○ строки\nкода", style=dashed];
    TestClassWriter  -> JavaFileWriter [style=dashed];
    PageObjectWriter -> Transliterator
        [label="↓○ russianName\n↑○ Java-имя", style=dashed];
    TestClassWriter  -> Transliterator [style=dashed];

    // → области данных
    TestGenerator -> GenFiles
        [label="↓○ записывает\n   *.java, pom.xml"];
    TestRunner    -> GenFiles
        [label="↑○ читает\n   surefire-reports/*.xml"];
    ReportDao     -> SQLite
        [label="↓○ INSERT\n↑○ SELECT ResultSet"];

    // ==== УРОВНИ ====
    { rank=same; XmlModelParser; TestConfig; TestGenerator; TestRunner; ReportDao; }
    { rank=same; EntityParser; SearchParser; PropertyGroupParser;
                 PageObjectWriter; TestClassWriter; EntityClassifier; TestDataFactory; }
    { rank=same; StaxUtils; XmlNamespaces; JavaFileWriter; Transliterator; }
    { rank=same; GenFiles; SQLite; }

    // ==== ЛЕГЕНДА ====
    subgraph cluster_legend {
        label="Условные обозначения (по Л. Константайну)";
        labelloc="b";
        style=dashed;
        fontsize=11;
        margin=12;

        L_mod  [shape=box, label="модуль"];
        L_lib  [shape=box, peripheries=2, label="библиотека"];
        L_data [shape=ellipse, label="область\nданных"];

        L_data_couple    [shape=plaintext, label="↓○ ↑○ — связь по данным (data couple)"];
        L_control_couple [shape=plaintext, label="↓● — связь по управлению (control couple)"];
        L_once           [shape=plaintext, label="1 — однократный вызов"];
        L_cycle          [shape=plaintext, label="«цикл» — циклический вызов"];
        L_common         [shape=plaintext, label="— — — common coupling (использование библиотеки)"];

        L_mod -> L_lib -> L_data [style=invis];
        L_data -> L_data_couple [style=invis];
        L_data_couple -> L_control_couple [style=invis];
        L_control_couple -> L_once [style=invis];
        L_once -> L_cycle [style=invis];
        L_cycle -> L_common [style=invis];
    }
}
