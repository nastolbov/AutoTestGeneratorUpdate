digraph Constantine {
    rankdir=TB;
    ranksep=0.9;
    nodesep=0.4;
    fontname="Arial";
    label="Модульная структура информационной системы AutoTestGenerator\n(по Л. Константайну)";
    labelloc="t";
    fontsize=18;
    splines=spline;

    node [shape=box, style="filled,rounded", fontname="Arial", fontsize=11, height=0.6];
    edge [fontname="Arial", fontsize=9];

    // ===== Level 1: Entry point =====
    App [label="App", fillcolor="#FFE4B5"];

    // ===== Level 2: Controller =====
    MainController [label="MainController", fillcolor="#FFE4B5"];

    // ===== Level 3: Subsystem facades =====
    XmlModelParser [label="XmlModelParser\n«фасад»", fillcolor="#B0E0E6"];
    TestConfig     [label="TestConfig",        fillcolor="#D8BFD8"];
    TestGenerator  [label="TestGenerator\n«дирижёр»", fillcolor="#D8BFD8"];
    TestRunner     [label="TestRunner",        fillcolor="#D8BFD8"];
    ReportDao      [label="ReportDao",         fillcolor="#FFB6C1"];

    // ===== Level 4: Specialised executors =====
    EntityParser        [label="EntityParser",       fillcolor="#B0E0E6"];
    SearchParser        [label="SearchParser",       fillcolor="#B0E0E6"];
    PropertyGroupParser [label="PropertyGroupParser",fillcolor="#B0E0E6"];
    PageObjectWriter    [label="PageObjectWriter",   fillcolor="#D8BFD8"];
    TestClassWriter     [label="TestClassWriter",    fillcolor="#D8BFD8"];
    EntityClassifier    [label="EntityClassifier\n(static)", fillcolor="#C1E1C1"];
    TestDataFactory     [label="TestDataFactory\n(static)", fillcolor="#D8BFD8"];

    // ===== Level 5: Shared utilities =====
    StaxUtils       [label="StaxUtils\n(static)", fillcolor="#F0F0F0"];
    XmlNamespaces   [label="XmlNamespaces\n(const)", fillcolor="#F0F0F0"];
    JavaFileWriter  [label="JavaFileWriter", fillcolor="#F0F0F0"];
    Transliterator  [label="Transliterator\n(static)", fillcolor="#F0F0F0"];
    ParserException [label="ParserException", fillcolor="#F0F0F0"];

    // ===== Level 6: External artifacts =====
    GenFiles [label="generated-tests/\n*.java + pom.xml", shape="folder", fillcolor="#FFFACD"];
    SQLite   [label="autotestgen.db\n(SQLite)", shape="cylinder", fillcolor="#FFFACD"];
    Mvn      [label="mvn test\n(child process)", shape="oval", fillcolor="#FFFACD"];

    // ===== Edges (calls + couples) =====
    // Level 1 -> 2
    App -> MainController [label="FXML load"];

    // Level 2 -> 3
    MainController -> XmlModelParser [label="○ File"];
    MainController -> TestConfig     [label="○ setters"];
    MainController -> TestGenerator  [label="○ AppModel"];
    MainController -> TestRunner     [label="○ filter\n● fastMode"];
    MainController -> ReportDao      [label="○ TestRunResult"];

    // Level 3 -> 4 (parser subtree)
    XmlModelParser -> EntityParser   [label="○ reader"];
    XmlModelParser -> SearchParser   [label="○ reader"];
    EntityParser   -> PropertyGroupParser [label="○ reader"];

    // Level 3 -> 4 (generator subtree)
    TestGenerator -> PageObjectWriter [label="○ entity"];
    TestGenerator -> TestClassWriter  [label="○ entity\n○ model"];
    TestGenerator -> EntityClassifier [label="○ entity\n○ model"];
    TestGenerator -> TestDataFactory  [label="○ property"];

    // Level 4 -> 5 (parsers use utils)
    EntityParser        -> StaxUtils     [style=dashed];
    SearchParser        -> StaxUtils     [style=dashed];
    PropertyGroupParser -> StaxUtils     [style=dashed];
    EntityParser        -> XmlNamespaces [style=dashed];
    SearchParser        -> XmlNamespaces [style=dashed];
    PropertyGroupParser -> XmlNamespaces [style=dashed];

    // Level 4 -> 5 (writers use common)
    PageObjectWriter -> JavaFileWriter  [style=dashed];
    PageObjectWriter -> Transliterator  [style=dashed];
    TestClassWriter  -> JavaFileWriter  [style=dashed];
    TestClassWriter  -> Transliterator  [style=dashed];

    // Exception path
    XmlModelParser -> ParserException [label="throws", style=dashed, color=red];

    // Outputs to external artifacts
    TestGenerator -> GenFiles [label="generate"];
    TestRunner    -> Mvn      [label="ProcessBuilder"];
    Mvn           -> GenFiles [label="reads", style=dashed];
    ReportDao     -> SQLite   [label="JDBC"];

    // ===== Layout hints =====
    { rank=same; XmlModelParser; TestConfig; TestGenerator; TestRunner; ReportDao; }
    { rank=same; EntityParser; SearchParser; PropertyGroupParser;
                  PageObjectWriter; TestClassWriter; EntityClassifier; TestDataFactory; }
    { rank=same; StaxUtils; XmlNamespaces; JavaFileWriter; Transliterator; ParserException; }
    { rank=same; Mvn; GenFiles; SQLite; }

    // ===== Legend =====
    subgraph cluster_legend {
        label="Условные обозначения";
        style="dashed";
        fontsize=11;
        L1 [label="UI / точка входа",        fillcolor="#FFE4B5", shape=box, style="filled,rounded"];
        L2 [label="Parser",                  fillcolor="#B0E0E6", shape=box, style="filled,rounded"];
        L3 [label="Generator",               fillcolor="#D8BFD8", shape=box, style="filled,rounded"];
        L4 [label="Model (EntityClassifier)",fillcolor="#C1E1C1", shape=box, style="filled,rounded"];
        L5 [label="Data (DAO)",              fillcolor="#FFB6C1", shape=box, style="filled,rounded"];
        L6 [label="Common (утилиты)",        fillcolor="#F0F0F0", shape=box, style="filled,rounded"];
        L7 [label="Внешний артефакт",        fillcolor="#FFFACD", shape=box, style="filled,rounded"];
        Lleg [label="○ data couple   ● control couple\n— — — общая утилита (common coupling)", shape=note, fillcolor="white"];
        L1 -> L2 -> L3 -> L4 -> L5 -> L6 -> L7 -> Lleg [style=invis];
    }
}
