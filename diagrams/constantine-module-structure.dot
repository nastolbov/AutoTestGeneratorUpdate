digraph Constantine {
    rankdir=TB;
    ranksep=1.4;
    nodesep=0.7;
    fontname="DejaVu Sans";
    label="Карта Константайна информационной системы AutoTestGenerator";
    labelloc="t";
    fontsize=18;

    node [fontname="DejaVu Sans", fontsize=12];
    edge [fontname="DejaVu Sans", fontsize=11, arrowsize=0.9];

    // ==== МОДУЛИ ====
    App                 [shape=box, label="App"];
    MainController      [shape=box, label="MainController"];
    XmlModelParser      [shape=box, label="XmlModelParser"];
    EntityParser        [shape=box, label="EntityParser"];
    SearchParser        [shape=box, label="SearchParser"];
    PropertyGroupParser [shape=box, label="PropertyGroupParser"];
    TestConfig          [shape=box, label="TestConfig"];
    TestGenerator       [shape=box, label="TestGenerator"];
    PageObjectWriter    [shape=box, label="PageObjectWriter"];
    TestClassWriter     [shape=box, label="TestClassWriter"];
    EntityClassifier    [shape=box, label="EntityClassifier"];
    TestDataFactory     [shape=box, label="TestDataFactory"];
    TestRunner          [shape=box, label="TestRunner"];
    ReportDao           [shape=box, label="ReportDao"];

    // ==== БИБЛИОТЕКИ (двойная рамка) ====
    StaxUtils      [shape=box, peripheries=2, label="StaxUtils"];
    XmlNamespaces  [shape=box, peripheries=2, label="XmlNamespaces"];
    JavaFileWriter [shape=box, peripheries=2, label="JavaFileWriter"];
    Transliterator [shape=box, peripheries=2, label="Transliterator"];

    // ==== ОБЛАСТИ ДАННЫХ ====
    SQLite   [shape=ellipse, label="autotestgen.db"];
    GenFiles [shape=ellipse, label="generated-tests/"];

    // ==== СВЯЗИ ====
    App -> MainController            [label=" FXML "];

    MainController -> XmlModelParser [label=" XML\n AppModel "];
    MainController -> TestConfig     [label=" параметры "];
    MainController -> TestGenerator  [label=" AppModel,\n TestConfig "];
    MainController -> TestRunner     [label=" outputDir,\n fastMode "];
    MainController -> ReportDao      [label=" RunResult,\n история "];

    XmlModelParser -> EntityParser   [label=" reader,\n EntityObject "];
    XmlModelParser -> SearchParser   [label=" reader,\n Search "];
    EntityParser -> PropertyGroupParser [label=" reader,\n PropertyGroup "];

    TestGenerator -> EntityClassifier [label=" цикл:\n entity,\n тип "];
    TestGenerator -> PageObjectWriter [label=" цикл:\n entity "];
    TestGenerator -> TestClassWriter  [label=" цикл:\n entity, уровень "];
    TestGenerator -> TestDataFactory  [label=" маска,\n значение "];

    // common coupling (пунктир)
    EntityParser -> StaxUtils         [label=" attr,\n parseInt ", style=dashed];
    SearchParser -> StaxUtils         [style=dashed];
    PropertyGroupParser -> StaxUtils  [style=dashed];
    EntityParser -> XmlNamespaces     [label=" NS_E, NS_E3 ", style=dashed];
    SearchParser -> XmlNamespaces     [style=dashed];
    PropertyGroupParser -> XmlNamespaces [style=dashed];

    PageObjectWriter -> JavaFileWriter [label=" строки кода ", style=dashed];
    TestClassWriter -> JavaFileWriter  [style=dashed];
    PageObjectWriter -> Transliterator [label=" Java-имена ", style=dashed];
    TestClassWriter -> Transliterator  [style=dashed];

    // области данных
    TestGenerator -> GenFiles [label=" запись:\n *.java, pom.xml "];
    TestRunner -> GenFiles    [label=" чтение:\n surefire-reports "];
    ReportDao -> SQLite       [label=" INSERT,\n SELECT "];

    // ==== УРОВНИ ====
    { rank=same; XmlModelParser; TestConfig; TestGenerator; TestRunner; ReportDao; }
    { rank=same; EntityParser; SearchParser; PropertyGroupParser;
                 PageObjectWriter; TestClassWriter; EntityClassifier; TestDataFactory; }
    { rank=same; StaxUtils; XmlNamespaces; JavaFileWriter; Transliterator; }
    { rank=same; GenFiles; SQLite; }

    // ==== ЛЕГЕНДА ====
    subgraph cluster_legend {
        label="Условные обозначения";
        labelloc="b";
        style=dashed;
        fontsize=11;
        margin=12;

        L_mod  [shape=box, label="модуль"];
        L_lib  [shape=box, peripheries=2, label="библиотека"];
        L_data [shape=ellipse, label="область\nданных"];
        L_dash [shape=plaintext, label="- - - common coupling\n(использование библиотеки)"];

        L_mod -> L_lib [style=invis];
        L_lib -> L_data [style=invis];
        L_data -> L_dash [style=invis];
    }
}
