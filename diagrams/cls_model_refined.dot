digraph MR {
    rankdir=TB; fontname="DejaVu Sans"; fontsize=14;
    label="Рис. 30. Уточнённая диаграмма классов пакета «Model»"; labelloc=b;
    nodesep=0.4; ranksep=0.6;
    node [fontname="DejaVu Sans", fontsize=10, shape=box, style=filled, fillcolor=white];
    edge [color=black, fontname="DejaVu Sans", fontsize=9];

    AM  [label="AppModel"];
    EO  [label="EntityObject"];
    PG  [label="PropertyGroup"];
    P   [label="Property"];
    Op  [label="Operation"];
    OP  [label="OperationParam"];
    M   [label="Modifier"];
    A   [label="Association"];
    S   [label="Search"];
    SP  [label="SearchParam"];
    SR  [label="SearchResult"];
    SRP [label="SearchResultProperty"];
    EC  [label="EntityClassifier"];
    CL  [label="Classification"];
    TRR [label="TestRunResult"];
    TCR [label="TestCaseResult"];

    // Композиция ♦ — иерархия владения
    AM -> EO   [arrowtail=diamond, dir=back, taillabel="1", headlabel="1..*"];
    AM -> S    [arrowtail=diamond, dir=back, taillabel="1", headlabel="0..*"];
    EO -> PG   [arrowtail=diamond, dir=back, taillabel="1", headlabel="1..*"];
    EO -> A    [arrowtail=diamond, dir=back, taillabel="1", headlabel="0..*"];
    PG -> P    [arrowtail=diamond, dir=back, taillabel="1", headlabel="1..*"];
    PG -> Op   [arrowtail=diamond, dir=back, taillabel="1", headlabel="0..1"];
    Op -> OP   [arrowtail=diamond, dir=back, taillabel="1", headlabel="0..*"];
    Op -> M    [arrowtail=diamond, dir=back, taillabel="1", headlabel="0..*"];
    S  -> SP   [arrowtail=diamond, dir=back, taillabel="1", headlabel="0..*"];
    S  -> SR   [arrowtail=diamond, dir=back, taillabel="1", headlabel="0..1"];
    SR -> SRP  [arrowtail=diamond, dir=back, taillabel="1", headlabel="0..*"];
    TRR -> TCR [arrowtail=diamond, dir=back, taillabel="1", headlabel="0..*"];

    // Ассоциация — create / use
    EC -> CL [taillabel="1", headlabel="*"];
    EC -> AM [taillabel="1", headlabel="1"];

    // Агрегация ◇ — Classification ссылается на чужие сущности
    CL -> EO [arrowtail=odiamond, dir=back, taillabel="0..1", headlabel="0..1"];
    CL -> PG [arrowtail=odiamond, dir=back, taillabel="0..1", headlabel="0..1"];
}
