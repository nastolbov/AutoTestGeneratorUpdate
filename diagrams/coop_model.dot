digraph CoopModel {
    rankdir=TB; fontname="Liberation Serif";
    nodesep=0.8; ranksep=0.9;
    node [fontname="Liberation Serif", fontsize=11, shape=box, style=filled, fillcolor=white];
    edge [color=black, fontname="Liberation Serif", fontsize=9, arrowsize=0.9];

    XMP [label=":XmlModelParser"];
    AM  [label=":AppModel"];
    EO  [label=":EntityObject"];
    PG  [label=":PropertyGroup"];
    P   [label=":Property"];
    TG  [label=":TestGenerator"];
    EC  [label="EntityClassifier"];
    CL  [label=":Classification"];

    XMP -> AM [label="создаёт корень модели,\nзаполняет списки сущностей\nи поисков"];
    XMP -> EO [label="создаёт сущность,\nатрибуты из XML"];
    XMP -> PG [label="создаёт группу,\nдобавляет в EntityObject"];
    XMP -> P  [label="создаёт поле формы,\nдобавляет в PropertyGroup"];
    EO  -> PG [label="вложенно владеет\nсписком групп"];
    PG  -> P  [label="вложенно владеет\nсписком полей"];
    AM  -> EO [label="вложенно владеет\nсписком сущностей"];

    TG  -> EC [label="сущность и модель\nдля классификации"];
    EC  -> AM [label="обход соседних\nсущностей для анализа"];
    EC  -> CL [label="создаёт результат:\nkind (PRIMARY/CHILD/REF),\nreason, parentEntity"];
    EC  -> TG [label="Classification обратно,\nрешение генерировать или нет"];
}
