graph G {
    layout=neato;
    fontname="Liberation Serif";
    overlap=false;
    splines=true;
    sep="+15";
    node [fontname="Liberation Serif", fontsize=12,
          shape=component, style=filled, fillcolor=white,
          width=1.8, height=0.8];
    edge [color=black, penwidth=1.2];

    // Центральный компонент — наше приложение
    AppJar [label="autotestgenerator.jar", pos="3,2!"];

    // Связи как в учебнике: простые линии без подписей и стрелок
    JavaFXC  [label="javafx-controls.jar", pos="0.5,4!"];
    JavaFXF  [label="javafx-fxml.jar",     pos="3,4.5!"];
    SQLite   [label="sqlite-jdbc.jar",     pos="6,2!"];
    StAX     [label="java.xml.stream\n(JDK 17 built-in)", pos="0,1.5!"];

    AppJar -- JavaFXC;
    AppJar -- JavaFXF;
    AppJar -- SQLite;
    AppJar -- StAX;
}
