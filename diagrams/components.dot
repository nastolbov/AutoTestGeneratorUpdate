digraph Components {
    rankdir=TB; fontname="Liberation Serif";
    nodesep=0.6; ranksep=0.9;
    node [fontname="Liberation Serif", fontsize=11, style=filled, fillcolor=white];
    edge [color=black, fontname="Liberation Serif", fontsize=10];

    subgraph cluster_app {
        label="AutoTestGenerator";
        style=rounded; labelloc=t;
        AppJar [shape=component, label="autotestgenerator.jar\n(main, GUI, парсер,\nгенератор, отчёты)"];
        JavaFX [shape=component, label="javafx-controls.jar\njavafx-fxml.jar"];
        SQLite [shape=component, label="sqlite-jdbc.jar"];
        StAX   [shape=component, label="java.xml.stream\n(встроен в JDK 17)"];

        AppJar -> JavaFX [style=dashed];
        AppJar -> SQLite [style=dashed];
        AppJar -> StAX   [style=dashed];
    }

    XmlFile  [shape=note,     label="model.xml\n(метаданные)"];
    SQLiteDb [shape=cylinder, label="autotestgen.db"];
    OutDir   [shape=folder,   label="generated-tests/\n(исходники)"];

    AppJar -> XmlFile  [label="чтение"];
    AppJar -> SQLiteDb [label="JDBC"];
    AppJar -> OutDir   [label="генерация .java"];
}
