digraph Parser {
    rankdir=TB; fontname="DejaVu Sans"; fontsize=14;
    label="Рис. 25. Уточнённая диаграмма классов пакета «Parser»"; labelloc=b;
    nodesep=0.5; ranksep=0.8;
    node [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled", fillcolor=white];
    edge [color=black, fontname="DejaVu Sans", fontsize=10];

    XmlModelParser      [label="XmlModelParser\n«фасад»"];
    EntityParser        [label="EntityParser"];
    PropertyGroupParser [label="PropertyGroupParser"];
