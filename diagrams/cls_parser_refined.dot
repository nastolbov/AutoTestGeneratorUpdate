digraph PR {
    rankdir=TB; fontname="Liberation Serif"; fontsize=14;
    label="Рис. 25. Уточнённая диаграмма классов пакета «Parser»"; labelloc=b;
    nodesep=0.7; ranksep=1.0;
    node [fontname="Liberation Serif", fontsize=12, shape=box, style=filled, fillcolor=white];
    edge [color=black, fontname="Liberation Serif", fontsize=10, labeldistance=2.0, arrowsize=0.9];

    XMP [label="XmlModelParser"];
    EP  [label="EntityParser"];
    PGP [label="PropertyGroupParser"];
    SP  [label="SearchParser"];
    SU  [label="StaxUtils"];
    XN  [label="XmlNamespaces"];

    XMP -> EP  [arrowtail=diamond, dir=back, taillabel="1", headlabel="1"];
    XMP -> SP  [arrowtail=diamond, dir=back, taillabel="1", headlabel="1"];
    EP  -> PGP [arrowtail=diamond, dir=back, taillabel="1", headlabel="1"];
    EP  -> SU; PGP -> SU; SP -> SU;
    EP  -> XN; PGP -> XN; SP -> XN;

    { rank=same; XMP; }
