digraph DD {
    rankdir=TB; fontname="Liberation Serif";
    nodesep=0.6; ranksep=0.9;
    node [fontname="Liberation Serif", fontsize=10, shape=record, style=filled, fillcolor=white];
    edge [color=black, fontname="Liberation Serif", fontsize=10, labeldistance=2.0, arrowsize=0.9];

    RD [label="{ReportDao|\
- connection: final DatabaseConnection\l\
- testRunDao: final TestRunDao\l\
- testCaseDao: final TestCaseDao\l\
|\
+ ReportDao()\l\
+ ReportDao(connection: DatabaseConnection)\l\
+ ReportDao(connection, testRunDao, testCaseDao)\l\
+ saveRun(result: TestRunResult): void\l\
+ getAllRuns(): List\<TestRunResult\>\l\
}"];

    DC [label="{DatabaseConnection|\
+ DEFAULT_URL: static final String\l\
- url: final String\l\
|\
+ DatabaseConnection()\l\
+ DatabaseConnection(url: String)\l\
+ open(): Connection\l\
+ getUrl(): String\l\
}"];

    SI [label="{SchemaInitializer|\
- connection: final DatabaseConnection\l\
|\
+ SchemaInitializer(connection)\l\
+ initialize(): void\l\
- createTestRunTable(stmt): void\l\
- createTestCaseTable(stmt): void\l\
}"];

    TRD [label="{TestRunDao|\
- connection: final DatabaseConnection\l\
\ \ DT_FORMAT: static final DateTimeFormatter\l\
|\
+ TestRunDao(DatabaseConnection)\l\
+ insert(conn, result): long\l\
+ selectAll(conn): List\<RunRow\>\l\
}"];

    TCD [label="{TestCaseDao|\
|\
+ insertBatch(conn, runId, cases): void\l\
+ selectByRunId(conn, runId): List\<TestCaseResult\>\l\
}"];

    RD -> DC  [arrowtail=diamond, dir=back, taillabel="1", headlabel="1"];
    RD -> TRD [arrowtail=diamond, dir=back, taillabel="1", headlabel="1"];
    RD -> TCD [arrowtail=diamond, dir=back, taillabel="1", headlabel="1"];
    RD -> SI  [taillabel="1", headlabel="1"];
    TRD -> DC [arrowtail=odiamond, dir=back, taillabel="1", headlabel="1"];
    SI  -> DC [arrowtail=odiamond, dir=back, taillabel="1", headlabel="1"];
}
