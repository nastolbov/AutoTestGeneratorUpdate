digraph State {
    rankdir=TB; fontname="DejaVu Sans"; fontsize=14;
    label="Рис. 11. Диаграмма переходов состояний"; labelloc=b;
    node [fontname="DejaVu Sans", fontsize=10, style=filled, fillcolor=white];
    edge [color=black, fontname="DejaVu Sans", fontsize=9];

    start [shape=circle, label="", fillcolor=black, width=0.3];
    final [shape=doublecircle, label="", fillcolor=black, width=0.3];

    Init      [shape=box, style="rounded,filled", fillcolor=white, label="Инициализация\nокно загружено,\nкнопки disabled"];
    Idle      [shape=box, style="rounded,filled", fillcolor=white, label="Готово\nXML не выбран"];
    Parsed    [shape=box, style="rounded,filled", fillcolor=white, label="Распаршено\nbtnGenerate enabled"];
    Generated [shape=box, style="rounded,filled", fillcolor=white, label="Сгенерировано\nbtnRunTests enabled"];
    Running   [shape=box, style="rounded,filled", fillcolor=white, label="Прогон тестов\nprogressBar visible,\nкнопки disabled"];
    Done      [shape=box, style="rounded,filled", fillcolor=white, label="Готово к новому циклу\nрезультаты в таблице"];
    Error     [shape=box, style="rounded,filled", fillcolor=white, label="Ошибка\nAlert показан"];

    start -> Init [label="start()"];
    Init -> Idle [label="initialize()"];
    Idle -> Parsed [label="onParse [XML валиден]"];
    Idle -> Error  [label="onParse [файл не найден\nили невалиден]"];
    Parsed -> Generated [label="onGenerate [success]"];
    Parsed -> Error     [label="onGenerate [IOException]"];
    Parsed -> Parsed    [label="onParse / повторно"];
    Generated -> Running [label="onRunTests"];
    Generated -> Running [label="onRunSelected(filter)"];
    Generated -> Generated [label="onGenerate / повторно"];
    Running -> Done  [label="Task.onSucceeded /\ndisplayResults + saveRun"];
    Running -> Error [label="Task.onFailed /\nIOException"];
    Done -> Running [label="onRunTests / повтор"];
    Done -> Parsed  [label="onSelectXml + onParse"];
    Done -> Done    [label="onShowHistory"];
    Error -> Idle      [label="OK / вернуться"];
    Error -> Parsed    [label="OK / [XML был ОК]"];
    Error -> Generated [label="OK / [тесты были ОК]"];
    Done -> final [label="закрыть окно"];
}
