digraph CoopParser {
    rankdir=TB; fontname="Liberation Serif";
    nodesep=0.8; ranksep=0.9;
    node [fontname="Liberation Serif", fontsize=11, shape=box, style=filled, fillcolor=white];
    edge [color=black, fontname="Liberation Serif", fontsize=9, arrowsize=0.9];

    MC   [label=":MainController"];
    XMP  [label=":XmlModelParser"];
    EP   [label=":EntityParser"];
    PGP  [label=":PropertyGroupParser"];
    SP   [label=":SearchParser"];
    SU   [label="StaxUtils"];
    XN   [label="XmlNamespaces"];

    MC  -> XMP [label="файл метаданных (File),\nназад: модель приложения\nлибо ParserException"];
    XMP -> EP  [label="XMLStreamReader\n(курсор в позиции <Object>)"];
    EP  -> PGP [label="XMLStreamReader\n(курсор в <Properties>)"];
    EP  -> SU  [label="имя атрибута\n→ строковое значение"];
    PGP -> SU  [label="имя атрибута → значение,\nпропуск элемента"];
    XMP -> SP  [label="XMLStreamReader\n(курсор в <Searches>)"];
    SP  -> SU  [label="имя атрибута, parseInt"];
    EP  -> XN  [label="константы NS_E, NS_E3\nдля сверки namespace"];
    PGP -> XN  [label="константы NS_E, NS_E3"];
    SP  -> XN  [label="константа NS_E3"];
}
