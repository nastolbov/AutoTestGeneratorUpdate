digraph CoopCommon {
    rankdir=LR; fontname="Liberation Serif";
    nodesep=1.4; ranksep=1.6;
    splines=true;
    node [fontname="Liberation Serif", fontsize=12, shape=box, style=filled, fillcolor=white];
    edge [color=black, fontname="Liberation Serif", fontsize=10, arrowsize=0.9];

    T  [label="Transliterator"];
    JW [label=":JavaFileWriter"];
    PE [label=":ParserException"];

    T  -> JW [label="имя класса Java\n(после toClassName)"];
    JW -> JW [label="накопление строк в StringBuilder,\nуправление отступом,\nзапись на диск через writeToFile"];
    JW -> PE [label="при IOException —\nсоздание исключения с\nсообщением и причиной (cause)"];
    PE -> JW [label="исключение готово\nк пробросу наверх"];
}
