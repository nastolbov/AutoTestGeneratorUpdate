digraph Packages {
    rankdir=TB; fontname="DejaVu Sans"; fontsize=14;
    label="Рис. 12. Диаграмма пакетов информационной системы"; labelloc=b;
    nodesep=0.5; ranksep=0.8;
    node [shape=tab, fontname="DejaVu Sans", fontsize=11, style=filled, fillcolor=white];
    edge [color=black, fontname="DejaVu Sans", fontsize=9];

    ui        [label="ui\n(3 класса)"];
    parser    [label="parser\n(6 классов)"];
    generator [label="generator\n(7 классов)"];
    data      [label="data\n(5 классов)"];
    model     [label="«global»\nmodel\n(20 классов)"];
    common    [label="«global»\ncommon\n(3 класса)"];

    ui -> parser    [label="«use»", style=dashed];
    ui -> generator [label="«use»", style=dashed];
    ui -> data      [label="«use»", style=dashed];
    ui -> model     [label="«use»", style=dashed];
    ui -> common    [label="«use»", style=dashed];

    parser    -> model  [label="«use»", style=dashed];
    parser    -> common [label="«use»", style=dashed];
    generator -> model  [label="«use»", style=dashed];
    generator -> common [label="«use»", style=dashed];
    data      -> model  [label="«use»", style=dashed];

    { rank=same; parser; generator; data; }
    { rank=same; model; common; }
}
