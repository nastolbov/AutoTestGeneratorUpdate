digraph Data {
    rankdir=TB; fontname="DejaVu Sans"; fontsize=14;
    label="Рис. 49. Уточнённая диаграмма классов пакета «Data»"; labelloc=b;
    nodesep=0.5; ranksep=0.9;
    node [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled", fillcolor=white];
    edge [color=black, fontname="DejaVu Sans", fontsize=10];

    ReportDao          [label="ReportDao\n«фасад»"];
    DatabaseConnection [label="DatabaseConnection"];
    SchemaInitializer  [label="SchemaInitializer"];
    TestRunDao         [label="TestRunDao"];
    TestCaseDao        [label="TestCaseDao"];

    ReportDao -> DatabaseConnection [arrowtail=diamond, dir=back, label="1"];
    ReportDao -> TestRunDao         [arrowtail=diamond, dir=back, label="1"];
    ReportDao -> TestCaseDao        [arrowtail=diamond, dir=back, label="1"];
    ReportDao -> SchemaInitializer  [style=dashed, label="«create at init»", fontsize=9];

    TestRunDao        -> DatabaseConnection [arrowtail=odiamond, dir=back, label="1"];
    SchemaInitializer -> DatabaseConnection [arrowtail=odiamond, dir=back, label="1"];

    { rank=same; ReportDao; }
    { rank=same; SchemaInitializer; TestRunDao; TestCaseDao; }
    { rank=same; DatabaseConnection; }
}
