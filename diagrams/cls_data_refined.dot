digraph DR {
    rankdir=TB; fontname="Liberation Serif"; fontsize=14;
    label="Рис. 49. Уточнённая диаграмма классов пакета «Data»"; labelloc=b;
    nodesep=0.7; ranksep=1.1;
    node [fontname="Liberation Serif", fontsize=12, shape=box, style=filled, fillcolor=white];
    edge [color=black, fontname="Liberation Serif", fontsize=10, labeldistance=2.0, arrowsize=0.9];

    RD  [label="ReportDao"];
    DC  [label="DatabaseConnection"];
    SI  [label="SchemaInitializer"];
    TRD [label="TestRunDao"];
    TCD [label="TestCaseDao"];

    RD -> DC  [arrowtail=diamond, dir=back, taillabel="1", headlabel="1"];
    RD -> TRD [arrowtail=diamond, dir=back, taillabel="1", headlabel="1"];
    RD -> TCD [arrowtail=diamond, dir=back, taillabel="1", headlabel="1"];
    RD -> SI  [taillabel="1", headlabel="1"];
    TRD -> DC [arrowtail=odiamond, dir=back, taillabel="1", headlabel="1"];
    SI  -> DC [arrowtail=odiamond, dir=back, taillabel="1", headlabel="1"];

    { rank=same; RD; }
    { rank=same; SI; TRD; TCD; }
    { rank=same; DC; }
}
