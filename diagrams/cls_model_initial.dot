digraph MII {
    rankdir=TB; fontname="Liberation Serif"; fontsize=14;
    label="Рис. 28. Исходная диаграмма классов пакета «Model»"; labelloc=b;
    nodesep=0.5; ranksep=0.8;
    node [fontname="Liberation Serif", fontsize=11, shape=box, style=filled, fillcolor=white];
    edge [color=black, fontname="Liberation Serif", fontsize=9, labeldistance=1.8, arrowsize=0.9];

    AM  [label="AppModel"];
    EO  [label="EntityObject"];
    PG  [label="PropertyGroup"];
    P   [label="Property"];
    Op  [label="Operation"];
    OP  [label="OperationParam"];
    M   [label="Modifier"];
    A   [label="Association"];
    S   [label="Search"];
    SP  [label="SearchParam"];
    SR  [label="SearchResult"];
    SRP [label="SearchResultProperty"];
    EC  [label="EntityClassifier"];
    CL  [label="Classification"];
    TRR [label="TestRunResult"];
    TCR [label="TestCaseResult"];

    AM -> EO   [label="содержит", taillabel="1", headlabel="1..*"];
    AM -> S    [label="содержит", taillabel="1", headlabel="0..*"];
    EO -> PG   [label="содержит", taillabel="1", headlabel="1..*"];
    EO -> A    [label="имеет",    taillabel="1", headlabel="0..*"];
    PG -> P    [label="содержит", taillabel="1", headlabel="1..*"];
    PG -> Op   [label="имеет",    taillabel="1", headlabel="0..1"];
    Op -> OP   [label="содержит", taillabel="1", headlabel="0..*"];
    Op -> M    [label="содержит", taillabel="1", headlabel="0..*"];
    S  -> SP   [label="содержит", taillabel="1", headlabel="0..*"];
    S  -> SR   [label="имеет",    taillabel="1", headlabel="0..1"];
    SR -> SRP  [label="содержит", taillabel="1", headlabel="0..*"];
    EC -> CL   [label="создаёт",  taillabel="1", headlabel="*"];
    TRR -> TCR [label="содержит", taillabel="1", headlabel="0..*"];
}
