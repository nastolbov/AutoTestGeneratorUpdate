digraph UII {
    rankdir=TB; fontname="Liberation Serif"; fontsize=14;
    label="Рис. 13. Исходная диаграмма классов пакета «UI»"; labelloc=b;
    nodesep=0.9; ranksep=1.1;
    node [fontname="Liberation Serif", fontsize=12, shape=box, style=filled, fillcolor=white];
    edge [color=black, fontname="Liberation Serif", fontsize=10, labeldistance=1.8, arrowsize=0.9];

    App            [label="App"];
