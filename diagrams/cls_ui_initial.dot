digraph UII {
    rankdir=TB; fontname="DejaVu Sans"; fontsize=14;
    label="Рис. 13. Исходная диаграмма классов пакета «UI»"; labelloc=b;
    nodesep=0.6; ranksep=0.9;
    node [fontname="DejaVu Sans", fontsize=11, shape=box, style=filled, fillcolor=white];
    edge [color=black, fontname="DejaVu Sans", fontsize=10];

    App            [label="App"];
    MainController [label="MainController"];
    TestCaseRow    [label="TestCaseRow"];

    App -> MainController            [label="загружает", taillabel="1", headlabel="1"];
    MainController -> TestCaseRow    [label="отображает",  taillabel="1", headlabel="*"];
}
