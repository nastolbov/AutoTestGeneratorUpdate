digraph PD {
    rankdir=TB; fontname="Liberation Serif";
    nodesep=0.6;
    node [fontname="Liberation Serif", fontsize=10, shape=record, style=filled, fillcolor=white];
    edge [color=black, fontname="Liberation Serif", fontsize=10, arrowsize=0.9];

    XMP [label="{XmlModelParser|\
- entityParser: final EntityParser\l\
- searchParser: final SearchParser\l\
|\
+ XmlModelParser()\l\
+ XmlModelParser(EntityParser, SearchParser)\l\
+ parse(xmlFile: File): AppModel\l\
}"];

    EP [label="{EntityParser|\
- pgParser: final PropertyGroupParser\l\
|\
+ EntityParser()\l\
+ EntityParser(PropertyGroupParser)\l\
+ parseObject(reader: XMLStreamReader): EntityObject\l\
- parseAssociation(reader: XMLStreamReader): Association\l\
}"];

    PGP [label="{PropertyGroupParser|\
|\
+ parsePropertyGroup(reader: XMLStreamReader): PropertyGroup\l\
- parseProperty(reader: XMLStreamReader): Property\l\
- parseOperation(reader: XMLStreamReader): Operation\l\
}"];

    SP [label="{SearchParser|\
|\
+ parseSearches(reader: XMLStreamReader): List\<Search\>\l\
- parseSingleSearch(reader: XMLStreamReader): Search\l\
}"];

    SU [label="{StaxUtils|\
|\
+ attr(reader: XMLStreamReader, name: String): static String\l\
+ parseInt(value: String): static int\l\
+ skipToEnd(reader: XMLStreamReader): static void\l\
}"];

    XN [label="{XmlNamespaces|\
+ NS_E: static final String\l\
+ NS_E3: static final String\l\
+ NS_MD: static final String\l\
|\
}"];

    XMP -> EP  [arrowtail=diamond, dir=back, label="содержит"];
    XMP -> SP  [arrowtail=diamond, dir=back, label="содержит"];
    EP  -> PGP [arrowtail=diamond, dir=back, label="содержит"];
    EP  -> SU [label="использует"]; PGP -> SU [label="использует"]; SP -> SU [label="использует"];
    EP  -> XN [label="использует"]; PGP -> XN [label="использует"]; SP -> XN [label="использует"];
}
