digraph PD {
    rankdir=TB; fontname="Liberation Serif";
    nodesep=0.6;
    node [fontname="Liberation Serif", fontsize=10, shape=record, style=filled, fillcolor=white];
    edge [color=black, fontname="Liberation Serif", fontsize=10, labeldistance=2.0, arrowsize=0.9];

    XMP [label="{XmlModelParser|\
- entityParser: final EntityParser\l\
- searchParser: final SearchParser\l\
|\
+ XmlModelParser()\l\
+ XmlModelParser(EntityParser, SearchParser)\l\
+ parse(xmlFile: File): AppModel\l\
}"];

    EP [label="{EntityParser|\
- pgParser: final PropertyGroupParser\l\
|\
+ parseObject(reader): EntityObject\l\
- parseAssociation(reader): Association\l\
}"];

    PGP [label="{PropertyGroupParser|\
|\
+ parsePropertyGroup(reader): PropertyGroup\l\
- parseProperty(reader): Property\l\
- parseOperation(reader): Operation\l\
}"];

    SP [label="{SearchParser|\
|\
+ parseSearches(reader): List\<Search\>\l\
- parseSingleSearch(reader): Search\l\
}"];

    SU [label="{StaxUtils|\
|\
+ attr(reader, name): static String\l\
+ parseInt(value): static int\l\
+ skipToEnd(reader): static void\l\
}"];

    XN [label="{XmlNamespaces|\
+ NS_E: static final String\l\
+ NS_E3: static final String\l\
+ NS_MD: static final String\l\
|\
}"];

    XMP -> EP  [arrowtail=diamond, dir=back, taillabel="1", headlabel="1"];
    XMP -> SP  [arrowtail=diamond, dir=back, taillabel="1", headlabel="1"];
    EP  -> PGP [arrowtail=diamond, dir=back, taillabel="1", headlabel="1"];
    EP  -> SU; PGP -> SU; SP -> SU;
    EP  -> XN; PGP -> XN; SP -> XN;
}
