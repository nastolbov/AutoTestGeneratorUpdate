digraph PD {
    rankdir=TB; fontname="DejaVu Sans"; fontsize=14;
    label="Рис. 26. Детальная диаграмма классов пакета «Parser»"; labelloc=b;
    nodesep=0.4;
    node [fontname="DejaVu Sans", fontsize=10, shape=plaintext];

    XmlModelParser [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><B>XmlModelParser  «фасад»</B></TD></TR>
        <TR><TD ALIGN="LEFT">— entityParser: final EntityParser<BR/>
            — searchParser: final SearchParser</TD></TR>
        <TR><TD ALIGN="LEFT">+ XmlModelParser()<BR/>
            + XmlModelParser(EntityParser, SearchParser)<BR/>
            + parse(xmlFile: File): AppModel<BR/>
            throws ParserException</TD></TR></TABLE>>];

    EntityParser [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><B>EntityParser</B></TD></TR>
        <TR><TD ALIGN="LEFT">— pgParser: final PropertyGroupParser</TD></TR>
        <TR><TD ALIGN="LEFT">+ parseObject(reader): EntityObject<BR/>
            — parseAssociation(reader): Association</TD></TR></TABLE>>];

    PGParser [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><B>PropertyGroupParser</B></TD></TR>
        <TR><TD ALIGN="LEFT">+ parsePropertyGroup(reader): PropertyGroup<BR/>
            — parseProperty(reader): Property<BR/>
            — parseOperation(reader): Operation</TD></TR></TABLE>>];

    SearchParser [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><B>SearchParser</B></TD></TR>
        <TR><TD ALIGN="LEFT">+ parseSearches(reader): List&lt;Search&gt;<BR/>
            — parseSingleSearch(reader): Search</TD></TR></TABLE>>];

    StaxUtils [label=<<TABLE BORDER="2" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><B>StaxUtils  «utility»</B></TD></TR>
        <TR><TD ALIGN="LEFT">+ attr(reader, name): static String<BR/>
            + parseInt(value): static int<BR/>
            + skipToEnd(reader): static void</TD></TR></TABLE>>];

    XmlNamespaces [label=<<TABLE BORDER="2" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><B>XmlNamespaces  «utility»</B></TD></TR>
        <TR><TD ALIGN="LEFT">+ NS_E, NS_E3, NS_MD:<BR/>
            static final String</TD></TR></TABLE>>];

    XmlModelParser -> EntityParser [arrowtail=diamond, dir=back, label="1"];
    XmlModelParser -> SearchParser [arrowtail=diamond, dir=back, label="1"];
    EntityParser -> PGParser [arrowtail=diamond, dir=back, label="1"];
    EntityParser -> StaxUtils [style=dashed]; PGParser -> StaxUtils [style=dashed]; SearchParser -> StaxUtils [style=dashed];
    EntityParser -> XmlNamespaces [style=dashed]; PGParser -> XmlNamespaces [style=dashed]; SearchParser -> XmlNamespaces [style=dashed];
}
