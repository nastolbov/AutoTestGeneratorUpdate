digraph PD {
    rankdir=TB; fontname="DejaVu Sans"; fontsize=14;
    label="Рис. 26. Детальная диаграмма классов пакета «Parser»"; labelloc=b;
    nodesep=0.4;
    node [fontname="DejaVu Sans", fontsize=10, shape=plaintext];

    XMP [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><B>XmlModelParser</B></TD></TR>
        <TR><TD ALIGN="LEFT">— entityParser: final EntityParser<BR/>
            — searchParser: final SearchParser</TD></TR>
        <TR><TD ALIGN="LEFT">+ XmlModelParser()<BR/>
            + XmlModelParser(EntityParser, SearchParser)<BR/>
            + parse(xmlFile: File): AppModel</TD></TR></TABLE>>];

    EP [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><B>EntityParser</B></TD></TR>
        <TR><TD ALIGN="LEFT">— pgParser: final PropertyGroupParser</TD></TR>
        <TR><TD ALIGN="LEFT">+ parseObject(reader): EntityObject<BR/>
            — parseAssociation(reader): Association</TD></TR></TABLE>>];

    PGP [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><B>PropertyGroupParser</B></TD></TR>
        <TR><TD ALIGN="LEFT">+ parsePropertyGroup(reader):<BR/>
              PropertyGroup<BR/>
            — parseProperty(reader): Property<BR/>
            — parseOperation(reader): Operation</TD></TR></TABLE>>];

    SP [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><B>SearchParser</B></TD></TR>
        <TR><TD ALIGN="LEFT">+ parseSearches(reader):<BR/>
              List&lt;Search&gt;<BR/>
            — parseSingleSearch(reader): Search</TD></TR></TABLE>>];

    SU [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><B>StaxUtils</B></TD></TR>
        <TR><TD ALIGN="LEFT">+ attr(reader, name): static String<BR/>
            + parseInt(value): static int<BR/>
            + skipToEnd(reader): static void</TD></TR></TABLE>>];

    XN [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><B>XmlNamespaces</B></TD></TR>
        <TR><TD ALIGN="LEFT">+ NS_E:  static final String<BR/>
            + NS_E3: static final String<BR/>
            + NS_MD: static final String</TD></TR></TABLE>>];

    XMP -> EP  [arrowtail=diamond, dir=back, taillabel="1", headlabel="1"];
    XMP -> SP  [arrowtail=diamond, dir=back, taillabel="1", headlabel="1"];
    EP  -> PGP [arrowtail=diamond, dir=back, taillabel="1", headlabel="1"];
    EP  -> SU; PGP -> SU; SP -> SU;
    EP  -> XN; PGP -> XN; SP -> XN;
}
