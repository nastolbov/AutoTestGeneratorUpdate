digraph GD {
    rankdir=TB; fontname="Liberation Serif";
    nodesep=0.5;
    node [fontname="Liberation Serif", fontsize=10, shape=record, style=filled, fillcolor=white];
    edge [color=black, fontname="Liberation Serif", fontsize=10, labeldistance=2.0, arrowsize=0.9];

    TC [label="{TestConfig|\
- baseUrl, login, password: String\l\
- outputDir: Path\l\
- browserType, basePackage, siteType,\l\
\ \ subsystemName, testLevel: String\l\
- smokeAllSubsystems: boolean\l\
|\
+ get/set для 10 полей\l\
}"];

    TG [label="{TestGenerator|\
- config: final TestConfig\l\
|\
+ TestGenerator(config: TestConfig)\l\
+ generate(model: AppModel): void\l\
- generatePom, generateBaseTest,\l\
\ \ generateSharedDriver, generateTestData,\l\
\ \ generateSubsystemsSmokeTest\l\
}"];

    POW [label="{PageObjectWriter|\
|\
+ write(entity: EntityObject, outputDir: Path): void\l\
}"];

    TCW [label="{TestClassWriter|\
|\
+ write(entity, model, outputDir): void\l\
+ writeChildTest(...): void\l\
}"];

    TDF [label="{TestDataFactory|\
|\
+ generateValue(prop): static String\l\
+ generateSearchParamValue(p): static String\l\
+ generateFromMask(mask): static String\l\
}"];

    TR [label="{TestRunner|\
- lastMavenOutput: String\l\
|\
+ run(projectDir, xml, url): TestRunResult\l\
+ run(..., lineConsumer): TestRunResult\l\
+ run(..., testFilter): TestRunResult\l\
+ run(..., testFilter, fastMode): TestRunResult\l\
}"];

    RRW [label="{RunReportWriter|\
|\
+ writeHtml(result, outputDir): void\l\
+ writeCsv(result, outputDir): void\l\
}"];

    TG -> TC  [arrowtail=odiamond, dir=back, taillabel="1", headlabel="1"];
    TG -> POW [taillabel="1", headlabel="*"];
    TG -> TCW [taillabel="1", headlabel="*"];
    TG -> TDF; POW -> TDF; TCW -> TDF;
}
