digraph GD {
    rankdir=TB; fontname="Liberation Serif";
    nodesep=0.5;
    node [fontname="Liberation Serif", fontsize=9, shape=record, style=filled, fillcolor=white];
    edge [color=black, fontname="Liberation Serif", fontsize=9, arrowsize=0.9];

    TC [label="{TestConfig|\
- baseUrl: String\l\
- login: String\l\
- password: String\l\
- outputDir: Path\l\
- browserType: String\l\
- basePackage: String\l\
- siteType: String\l\
- subsystemName: String\l\
- testLevel: String\l\
|\
+ геттеры и сеттеры всех полей\l\
}"];

    TG [label="{TestGenerator|\
- config: TestConfig\l\
|\
+ TestGenerator(config: TestConfig)\l\
+ generate(model: AppModel): void\l\
- generatePom(outputDir: Path): void\l\
- generateJUnitConfig(outputDir: Path): void\l\
- generateSharedDriver(srcDir: Path, basePackage: String): void\l\
- generateBaseTest(srcDir: Path, basePackage: String): void\l\
- generateTestData(srcDir: Path, basePackage: String): void\l\
}"];

    POW [label="{PageObjectWriter|\
- basePackage: String\l\
|\
+ PageObjectWriter(basePackage: String)\l\
+ write(entity: EntityObject, outputDir: Path): void\l\
- writeInputMethod(w: JavaFileWriter, prop: Property): void\l\
}"];

    TCW [label="{TestClassWriter|\
- basePackage: String\l\
- testLevel: String\l\
|\
+ TestClassWriter(basePackage: String, testLevel: String)\l\
+ write(entity: EntityObject, model: AppModel, outputDir: Path): void\l\
- writeFieldsPresentTest(w: JavaFileWriter, properties: List): void\l\
- writeRequiredFieldValidationTest(w: JavaFileWriter, required: List): void\l\
- writeCreateTest(w: JavaFileWriter): void\l\
- writeUpdateTest(w: JavaFileWriter, properties: List): void\l\
- writeDeleteTest(w: JavaFileWriter): void\l\
- writeSearchTest(w: JavaFileWriter): void\l\
- writeGridTest(w: JavaFileWriter): void\l\
}"];

    TDF [label="{TestDataFactory|\
- DATE_FORMAT: static DateTimeFormatter\l\
- RND: static Random\l\
|\
+ generateValue(property: Property): static String\l\
+ generateSearchParamValue(param: SearchParam): static String\l\
+ generateFromMask(mask: String): static String\l\
+ generateValueExpression(property: Property): static String\l\
}"];

    TR [label="{TestRunner|\
- lastMavenOutput: String\l\
|\
+ run(projectDir: Path, xmlFileName: String, baseUrl: String): TestRunResult\l\
+ run(..., lineConsumer: Consumer\<String\>): TestRunResult\l\
+ getLastMavenOutput(): String\l\
- parseSurefireReports(reportsDir: Path, runResult: TestRunResult): void\l\
- parseIntAttr(reader: XMLStreamReader, name: String): int\l\
- parseDoubleAttr(reader: XMLStreamReader, name: String): double\l\
}"];

    RRW [label="{RunReportWriter|\
|\
+ write(htmlPath: Path, result: TestRunResult): void\l\
+ writeCsv(csvPath: Path, result: TestRunResult): void\l\
- csv(v: String): static String\l\
- esc(s: String): static String\l\
- shortName(cls: String): static String\l\
- extractStepLabel(filename: String): static String\l\
- formatDuration(ms: long): static String\l\
}"];

    TG -> TC [arrowtail=odiamond, dir=back, label="содержит"];
    TG -> POW [label="использует"]; TG -> TCW [label="использует"];
    POW -> TDF [label="использует"]; TCW -> TDF [label="использует"];
    TR -> RRW [label="использует"];
}
