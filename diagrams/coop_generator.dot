digraph CoopGen {
    rankdir=TB; fontname="DejaVu Sans"; fontsize=14;
    label="Рис. 31. Диаграмма кооперации пакета «Generator»\n(1.x — generate, 2.x — run; 1.x.Ex — IOException)"; labelloc=b;
    nodesep=0.7;
    node [fontname="DejaVu Sans", fontsize=11, shape=box, style=filled, fillcolor=white];
    edge [color=black, fontname="DejaVu Sans", fontsize=9];

    MC   [label=":MainController"];
    TC   [label=":TestConfig"];
    TG   [label=":TestGenerator"];
    POW  [label=":PageObjectWriter"];
    TCW  [label=":TestClassWriter"];
    TDF  [label="TestDataFactory"];
    TR   [label=":TestRunner"];
    Mvn  [label="ProcessBuilder\n(\"mvn test\")"];

    MC -> TC  [label="1: new TestConfig(...)"];
    MC -> TG  [label="2: new TestGenerator(config)\n3: generate(model)"];
    TG -> POW [label="3.1: цикл по PRIMARY-сущностям\n     write(entity, outputDir)"];
    TG -> TCW [label="3.2: цикл по PRIMARY-сущностям\n     write(entity, model, outputDir)"];
    POW -> TDF [label="3.1.1: generateValue(prop)"];
    TCW -> TDF [label="3.2.1: generateValue(prop)"];
    MC -> TR  [label="4: run(outputDir, xml, url, filter, fastMode)"];
    TR -> Mvn [label="4.1: start()"];
    Mvn -> TR [label="4.2: stdout строки"];
    TR -> MC  [label="4.99: TestRunResult\n3.Ex: IOException"];
}
