digraph CoopGen {
    rankdir=TB; fontname="Liberation Serif";
    nodesep=0.9; ranksep=0.9;
    node [fontname="Liberation Serif", fontsize=11, shape=box, style=filled, fillcolor=white];
    edge [color=black, fontname="Liberation Serif", fontsize=9, arrowsize=0.9];

    MC   [label=":MainController"];
    TC   [label=":TestConfig"];
    TG   [label=":TestGenerator"];
    POW  [label=":PageObjectWriter"];
    TCW  [label=":TestClassWriter"];
    TDF  [label="TestDataFactory"];
    TR   [label=":TestRunner"];
    Mvn  [label="ProcessBuilder\n(mvn test)"];
    RRW  [label=":RunReportWriter"];

    MC -> TC  [label="настройки: URL, логин,\nпароль, каталог,\nуровень тестов, fastMode"];
    MC -> TG  [label="конфигурация,\nобъектная модель (AppModel)"];
    TG -> POW [label="сущность,\nкаталог вывода"];
    TG -> TCW [label="сущность, модель,\nуровень тестов"];
    POW -> TDF [label="свойство (Property)\n→ корректное значение\nпо типу и маске"];
    TCW -> TDF [label="свойство → значение"];
    TG -> MC  [label="готовый Maven-проект\nв каталоге generated-tests/"];
    MC -> TR  [label="каталог проекта,\nfilter, fastMode"];
    TR -> Mvn [label="команда mvn test\nс параметрами"];
    Mvn -> TR [label="stdout (живой лог),\nfile surefire-reports/*.xml"];
    TR -> RRW [label="агрегированный результат\nTestRunResult"];
    TR -> MC  [label="результат прогона:\nсчётчики, кейсы, лог"];
}
