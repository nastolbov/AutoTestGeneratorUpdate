digraph UI {
    rankdir=TB; fontname="DejaVu Sans"; fontsize=14;
    label="Рис. 18. Уточнённая диаграмма классов пакета «UI»"; labelloc=b;
    nodesep=0.6; ranksep=0.9;
    node [fontname="DejaVu Sans", fontsize=12, shape=box, style="rounded,filled", fillcolor=white];
    edge [color=black, fontname="DejaVu Sans", fontsize=10];

    App            [label="App"];
    MainController [label="MainController"];
    TestCaseRow    [label="TestCaseRow"];

    App -> MainController [label="«create»\n(через FXML)", style=dashed, fontsize=9];
    MainController -> TestCaseRow [arrowtail=diamond, dir=back, label="1..*"];
}
