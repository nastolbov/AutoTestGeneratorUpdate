digraph Deployment {
    rankdir=TB;
    fontname="DejaVu Sans";
    fontsize=14;
    labelloc=b;
    nodesep=0.6;
    ranksep=1.0;
    compound=true;

    node [fontname="DejaVu Sans", fontsize=11, style=filled, fillcolor=white];
    edge [color=black, fontname="DejaVu Sans", fontsize=10];

    // ============================================
    // ВЕРХ: Web-сервер с тестируемыми приложениями
    // ============================================
    subgraph cluster_ws {
        label="Web-сервер E3Core";
        style="rounded,filled";
        fillcolor="#f7f7f7";
        labelloc=t;
        fontsize=12;
        margin=14;

        WebApp1 [shape=component, label="Тестируемое web-\nприложение 1"];
        WebDots [shape=plaintext, label="..."];
        WebAppN [shape=component, label="Тестируемое web-\nприложение N"];
    }

    // ============================================
    // СРЕДИНА: Интернет
    // ============================================
    Internet [shape=box3d, label="Интернет", width=4, height=0.7];

    // ============================================
    // НИЗ: Сервер тестирования
    // ============================================
    subgraph cluster_test {
        label="Сервер тестирования";
        style="rounded,filled";
        fillcolor="#f7f7f7";
        labelloc=t;
        fontsize=12;
        margin=14;

        App     [shape=component, label="AutotestGeneratorApp"];
        XmlFile [shape=note,      label="XML-файл\nметамодели"];
        Maven   [shape=component, label="Apache Maven"];
        GenProj [shape=folder,    label="generated-tests/\n(JUnit 5 + Selenium)"];
        WebDrv  [shape=component, label="ChromeDriver\n(Selenium WebDriver)"];
        Chrome  [shape=component, label="Браузер Chrome"];
        DB      [shape=cylinder,  label="SQLite\nautotestgen.db"];

        // Связи внутри сервера тестирования (со стрелками)
        XmlFile -> App     [label=" XML "];
        App     -> DB      [label=" история\n прогонов "];
        App     -> GenProj [label=" генерация\n *.java, pom.xml "];
        App     -> Maven   [label=" mvn test "];
        Maven   -> GenProj [label=" компиляция,\n запуск "];
        Maven   -> WebDrv  [label=" Selenium API "];
        WebDrv  -> Chrome  [label=" управление "];
    }

    // ============================================
    // СВЯЗИ МЕЖДУ КЛАСТЕРАМИ (через Интернет)
    // ============================================
    Chrome -> Internet [label=" HTTPS\n запросы "];
    Internet -> WebApp1 [style=dashed, label=" HTTPS "];
    Internet -> WebAppN [style=dashed];
}
