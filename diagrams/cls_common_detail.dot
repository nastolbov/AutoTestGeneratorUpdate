digraph CD {
    rankdir=LR; fontname="DejaVu Sans"; fontsize=14;
    label="Рис. 53. Детальная диаграмма классов пакета «Common»"; labelloc=b;
    nodesep=0.7;
    node [fontname="DejaVu Sans", fontsize=10, shape=plaintext];

    Transl [label=<<TABLE BORDER="2" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><B>Transliterator  «utility»</B></TD></TR>
        <TR><TD ALIGN="LEFT">— MAPPING: static final<BR/>
            Map&lt;Character, String&gt;</TD></TR>
        <TR><TD ALIGN="LEFT">+ toClassName(s): static String<BR/>
            + toMethodName(s): static String<BR/>
            + toFieldName(s): static String</TD></TR></TABLE>>];

    JFW [label=<<TABLE BORDER="2" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><B>JavaFileWriter  «utility»</B></TD></TR>
        <TR><TD ALIGN="LEFT">— sb: final StringBuilder<BR/>
            — indentLevel: int<BR/>
            — INDENT: static "    "</TD></TR>
        <TR><TD ALIGN="LEFT">+ writeLine(line): JavaFileWriter<BR/>
            + openBlock(header): JavaFileWriter<BR/>
            + closeBlock(): JavaFileWriter<BR/>
            + writeToFile(dir, fileName)</TD></TR></TABLE>>];

    PE [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><B>ParserException  «exception»</B></TD></TR>
        <TR><TD ALIGN="LEFT">+ ParserException(message)<BR/>
            + ParserException(message, cause)</TD></TR></TABLE>>];
}
