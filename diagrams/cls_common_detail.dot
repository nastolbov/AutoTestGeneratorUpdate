digraph CD {
    rankdir=LR; fontname="Liberation Serif";
    nodesep=1.0;
    node [fontname="Liberation Serif", fontsize=10, shape=record, style=filled, fillcolor=white];

    T [label="{Transliterator|\
- MAPPING: static final Map\<Character, String\>\l\
|\
+ toClassName(s: String): static String\l\
+ toMethodName(s: String): static String\l\
+ toFieldName(s: String): static String\l\
- transliterate(w: String): static String\l\
- snakeToCamel(s: String): static String\l\
}"];

    JW [label="{JavaFileWriter|\
- sb: final StringBuilder\l\
- indentLevel: int\l\
- INDENT: static \"    \"\l\
|\
+ writeLine(line: String): JavaFileWriter\l\
+ writeLine(): JavaFileWriter\l\
+ openBlock(header: String): JavaFileWriter\l\
+ closeBlock(): JavaFileWriter\l\
+ writeToFile(dir: Path, fileName: String): void\l\
+ toString(): String\l\
}"];

    PE [label="{ParserException|\
|\
+ ParserException(message: String)\l\
+ ParserException(message: String, cause: Throwable)\l\
}"];
}
